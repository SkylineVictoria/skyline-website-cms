# Server-only Edge configuration. Copy to ignored supabase/functions/.env for local use.
# Never upload this example, commit real values, or put these names in VITE_*.
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY and SUPABASE_ANON_KEY are managed/injected.
# SUPABASE_PUBLISHABLE_KEY is the existing optional singular fallback for ANON_KEY.
# Do not duplicate managed credentials under EF_* names.
# Current compatible contracts: leave provider/worker secrets empty until owner-configured.
OPENAI_API_KEY=
OPENAI_DOCUMENT_MODEL=
DOCUMENT_EXTRACTION_WORKER_SECRET=
PUBLIC_ASSISTANT_WORKER_SECRET=
PUBLIC_ASSISTANT_EMBEDDING_MODEL=text-embedding-3-small
PUBLIC_ASSISTANT_EMBEDDING_DIMENSIONS=1536
PUBLIC_ASSISTANT_GENERATION_MODEL=gpt-4.1-mini
PUBLIC_ASSISTANT_ENABLE_GENERATION=false
PUBLIC_ASSISTANT_DOCUMENT_EXTRACTION_MODEL=gpt-4.1-mini
PUBLIC_ASSISTANT_DOCUMENT_MAX_BYTES=20971520
PUBLIC_ASSISTANT_DOCUMENT_MAX_PAGES=120
PUBLIC_ASSISTANT_MAX_CONTENT_CHARS=500000
PUBLIC_ASSISTANT_MAX_CHUNKS=512
PUBLIC_ASSISTANT_CHUNK_TOKENS=420
PUBLIC_ASSISTANT_CHUNK_OVERLAP=60
# OPENAI_BASE_URL=http://127.0.0.1:PORT/v1 # synthetic local mocks only; never a real provider key.
# Future EF_* names are proposals only; see docs/EDGE_FUNCTION_SECRETS.md.
# Document extraction provider (Phase 5, P05-02). Unset keeps the existing OpenAI provider.
# Azure is used only when EF_DOCUMENT_EXTRACTION_PROVIDER=azure AND all three required values are set; otherwise manual entry continues.
# EF_DOCUMENT_EXTRACTION_PROVIDER=openai
# EF_AZURE_DOCUMENT_ENDPOINT=https://your-resource.cognitiveservices.azure.com
# EF_AZURE_DOCUMENT_API_KEY=
# EF_AZURE_DOCUMENT_MODEL=prebuilt-idDocument
# EF_AZURE_DOCUMENT_MODEL_MAP={"English Test":"custom-model-id"}
# EF_AZURE_DOCUMENT_API_VERSION=2024-11-30
# Notification email: only these two names. Sender address/name come from the database per organization (migration 87), the worker is
# authenticated with the service-role key, and the Postmark webhook is disabled. Sending is OFF unless the switch is exactly "true" AND the token is set.
# EF_NOTIFICATION_EMAIL_ENABLED=false
# EF_POSTMARK_SERVER_TOKEN=
