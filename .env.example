# Public browser configuration. Never put a service-role/secret key in VITE_*.
VITE_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
VITE_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Use the canonical production origin on Vercel; no trailing path or slash.
VITE_PUBLIC_SITE_URL=https://your-project.vercel.app

VITE_PUBLIC_SITE_URL
# Server-only Edge configuration: supabase/functions/.env.example
# Existing OpenAI/worker variable names are preserved; future EF_* names need reviewed adapters.
# Never add provider tokens, worker secrets or service-role credentials to VITE_*.
# Cloudflare Turnstile SITE key (public) for the staff application form. "local-mock" shows a local mock check (local stacks only).
VITE_CAPTCHA_SITE_KEY=your-turnstile-site-key
